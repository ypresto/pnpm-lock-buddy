{
  "name": "pnpm-lock-buddy",
  "version": "0.4.0",
  "description": "CLI tool for analyzing pnpm-lock.yaml files",
  "author": "ypresto <yuya.presto@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ypresto/pnpm-lock-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/ypresto/pnpm-lock-buddy/issues"
  },
  "homepage": "https://github.com/ypresto/pnpm-lock-buddy",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "pnpm",
    "lockfile",
    "dependencies",
    "analysis",
    "cli"
  ],
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1",
  "files": [
    "dist"
  ],
  "main": "dist/cli/index.js",
  "type": "module",
  "bin": {
    "pnpm-lock-buddy": "./dist/cli/index.js"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --no-watch",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "NODE_OPTIONS=--expose-gc vitest run test/bench",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pnpm/deps.inspection.tree-builder": "^1101.0.2",
    "@pnpm/deps.path": "^1101.0.1",
    "@pnpm/lockfile.types": "^1100.1.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@pnpm/test-fixtures": "^1000.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
